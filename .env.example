NODE_ENV=development
PORT=3000
LOG_LEVEL=info
BOT_NAME=Tux

# Supabase (required in production)
SUPABASE_URL=
SUPABASE_API_KEY=
SUPABASE_BOT_SECRET=
# 32 bytes as 64 hex characters or base64
AUTH_ENCRYPTION_KEY=

# Admin panel login: set ONE of these (hash wins if both are set)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Short secret word used once with !claim to become a bot admin
PAIR_TOKEN=

# Optional
ADMIN_JIDS=
OWNER_JID=
HEALTH_TOKEN=
WEB_SESSION_SECRET=
MAX_AI_QUEUE=20
MAX_MESSAGE_CHARS=4096
# Kilo only
KILO_BASE_URL=
KILO_MODEL=
